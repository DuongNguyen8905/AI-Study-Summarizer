# Google Gemini AI Studio API Key (Lấy miễn phí tại https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# JWT Secret Key
SECRET_KEY=super-secret-key-for-ai-study-summarizer-saas-2026

# Database (Mặc định dùng SQLite cục bộ, có thể đổi sang PostgreSQL)
DATABASE_URL=sqlite:///./study_summarizer.db
